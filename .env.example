# Agent 1 trading gates (Survival First — disabled by default)
TRADING_ENABLED=false
KILL_SWITCH=false

# Provisional policy limits (Slice A/B defaults)
MAX_TRADE_USDC=25
DAILY_VOLUME_USDC=100
SLIPPAGE_BPS=250
COOLDOWN_SECONDS=1800

# Optional deny filter — comma-separated MeToken addresses (discovery remains subgraph)
AGENT1_DENIED_METOKENS=

# Creative Platform subgraph (Studio preferred; Goldsky fallback only)
SUBGRAPH_PROVIDER_MODE=studio
GRAPH_STUDIO_CREATIVE_PLATFORM_URL=https://api.studio.thegraph.com/query/3405/creative-platform/version/latest
# Legacy alias (optional)
SUBGRAPH_URL=https://api.studio.thegraph.com/query/3405/creative-platform/version/latest

# Goldsky fallback (currently 404 as of 2026-09-21 — Studio is live source)
# GOLDSKY_PROJECT_ID=project_cmh0iv6s500dbw2p22vsxcfo6
# GOLDSKY_API_KEY=

# Agent 1 wallet (balances + Slice C Alchemy prepare `from` address)
AGENT1_WALLET_ADDRESS=

# Alchemy Wallet APIs (Slice C — prepare/dry-run only; never commit real keys)
# Required for wallet_prepareCalls during dry-run when AGENT1_DRY_RUN_PREPARE is enabled
ALCHEMY_API_KEY=
# Optional alias
# ALCHEMY_WALLET_API_KEY=
# Optional Gas Manager policy for sponsored prepare simulation
# ALCHEMY_GAS_POLICY_ID=
# Attempt Alchemy wallet_prepareCalls during dry-run when credentials exist (default: true)
AGENT1_DRY_RUN_PREPARE=true

# Base RPC for read-only USDC balance + optional onchain diamond quotes
BASE_RPC_URL=
# ALCHEMY_BASE_RPC_URL=

# Read-only quote path (G2 must confirm diamond/router before live execute)
# mock = staging ratio quote; onchain = calculateMeTokensMinted via diamond (requires BASE_RPC_URL)
AGENT1_QUOTE_MODE=mock
# Staging reference only — do NOT treat as production-confirmed until G2 signs off
# AGENT1_METOKENS_DIAMOND_ADDRESS=0xba5502db2aC2cBff189965e991C07109B14eB3f5

# Cron auth for future /api/agent1/tick (set in deployment; never commit real values)
CRON_SECRET=
